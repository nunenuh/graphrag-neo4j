# ==============================================================================
# GraphRAG Service - Environment Configuration
# ==============================================================================
# Copy this file to .env and update with your actual values

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME="GraphRAG Service"
APP_VERSION="0.1.0"
APP_ENVIRONMENT="development"
APP_HOST="0.0.0.0"
APP_PORT=8005
APP_DEBUG=true

# API Authentication
APP_X_API_KEY="changeme-in-production"

# CORS Settings (comma-separated origins or * for all)
ALLOWED_ORIGINS_STR="http://localhost:3000,http://localhost:5179"

# ==============================================================================
# NEO4J SETTINGS
# ==============================================================================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# ==============================================================================
# LLM SETTINGS (LangChain provider-agnostic)
# ==============================================================================
# Provider: openai | google | ollama | qwen
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"

# Embedding provider (can differ from LLM provider)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536

# ==============================================================================
# PROVIDER API KEYS (set only the ones you use)
# ==============================================================================
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Ollama (local models — no API key needed)
OLLAMA_BASE_URL="http://localhost:11434"

# ==============================================================================
# RAG SETTINGS
# ==============================================================================
TOP_K_SEED_NODES=5
TRAVERSAL_DEPTH=2

# ==============================================================================
# DATA SETTINGS
# ==============================================================================
DATA_DIR="data"
MAX_PAPERS=5000
MAX_METHODS=0
MAX_TASKS=0
MAX_DATASETS=0
INGEST_BATCH_SIZE=50
